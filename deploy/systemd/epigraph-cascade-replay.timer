# Runs epigraph-cascade-replay.service every 90 s, the interval the binary
# documents. A TEMPLATE: see the service file and docs/deploy.md step 10.
#
# OnUnitActiveSec counts from the last start, so a run still going when the
# interval elapses is not started twice; the replay's own advisory lock
# covers a hand-started run beside it. OnBootSec gives the first trigger.

[Unit]
Description=Run the EpiGraph deferred-cascade replay every 90 s

[Timer]
OnBootSec=90s
OnUnitActiveSec=90s
AccuracySec=5s
Unit=epigraph-cascade-replay.service

[Install]
WantedBy=timers.target
