# Runs epigraph-prune-recall-events.service once a day. A TEMPLATE: see the
# service file and docs/deploy.md step 10.
# Install it without the `.example` suffix, as
# /etc/systemd/system/epigraph-prune-recall-events.timer.
#
# 04:10 local is a default, not a requirement: pick a quiet slot clear of the
# host's backup window, so a large DELETE never overlaps a backup.

[Unit]
Description=Run the EpiGraph recall-audit retention

[Timer]
OnCalendar=*-*-* 04:10:00
Persistent=true
AccuracySec=1min
Unit=epigraph-prune-recall-events.service

[Install]
WantedBy=timers.target
