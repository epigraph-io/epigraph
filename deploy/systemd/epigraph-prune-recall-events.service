# EpiGraph recall-audit retention (prune_recall_events, epigraph-cli).
#
# A TEMPLATE: nothing in this repository installs it. Copy it, replace the
# placeholders (the binary path, the service user, the environment file) and
# install it by hand: docs/deploy.md, step 10.
#
# Deletes recall_events rows and telemetry events rows older than
# RECALL_EVENTS_RETENTION_DAYS (default 90; set it in the environment file to
# change it). The environment file (0600, owned by root) holds
# MAINTENANCE_DATABASE_URL and DATABASE_URL (the same database). On an
# application login under row security the DELETE matches nothing and the run
# still exits 0, so use the maintenance login.

[Unit]
Description=EpiGraph recall-audit retention
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=epigraph-maintenance
Group=epigraph-maintenance
EnvironmentFile=/etc/epigraph/maintenance.env
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/prune_recall_events
# The binary takes no lock: do not start a second copy beside the timer's.
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
