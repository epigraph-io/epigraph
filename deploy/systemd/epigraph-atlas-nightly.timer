# Runs epigraph-atlas-nightly.service once a night (Atlas W9). A TEMPLATE:
# see the service file and docs/runbooks/atlas-nightly.md.
#
# 04:30 local is a default, not a requirement: pick a quiet slot on the
# host, clear of its backup window and of any other job that holds long
# transactions on the database. This job replaces the paused
# theme-maintenance task (docs/ops/theme-v2-promotion-runbook.md).

[Unit]
Description=Run the EpiGraph Atlas nightly map refresh

[Timer]
OnCalendar=*-*-* 04:30:00
Persistent=true
AccuracySec=1min
Unit=epigraph-atlas-nightly.service

[Install]
WantedBy=timers.target
