# EpiGraph deferred-cascade replay (replay_deferred_cascades, epigraph-cli).
#
# A TEMPLATE: nothing in this repository installs it. Copy it, replace the
# placeholders (the binary path, the service user, the environment file) and
# install it by hand, without the `.example` suffix, as
# /etc/systemd/system/epigraph-cascade-replay.service
# (docs/deploy.md, step 10 and section 5).
#
# No request-serving process applies a cascade: each one is deferred and this
# run applies it. The API and MCP server name this unit's timer when they
# refuse the maintenance DSN, and in their start-up line.
#
# The environment file (0600, owned by root) holds MAINTENANCE_DATABASE_URL
# (required; the fallback to DATABASE_URL is refused) and DATABASE_URL, which
# must name the same database. The maintenance login must bypass row security.

[Unit]
Description=EpiGraph deferred-cascade replay
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=epigraph-maintenance
Group=epigraph-maintenance
EnvironmentFile=/etc/epigraph/maintenance.env
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/replay_deferred_cascades --max-failures 20
# Exit 2: a cascade is stuck (failed --max-failures times). It is a failure on
# purpose, so the unit shows failed until an operator reads the report and
# retires it by hand (`--retire <event id> --reason <text>`). A run that finds
# another holding the replay's lock prints {"locked": true} and exits 0.
TimeoutStartSec=30min
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
