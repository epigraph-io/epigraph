# EpiGraph Atlas nightly map refresh (Atlas W9).
#
# A TEMPLATE: nothing in this repository installs it. Copy it, replace the
# placeholders (the binary path, the service user, the environment file) and
# install it by hand: docs/runbooks/atlas-nightly.md, "Enable the timer".
#
# The binary runs on the maintenance DSN only (MAINTENANCE_DATABASE_URL in
# the environment file, 0600). It names groups through the Claude CLI, which
# signs in as the service user: run it as a user whose home holds that
# sign-in, and do not set ProtectHome= (the naming step keeps a private
# working directory under the user's home).

[Unit]
Description=EpiGraph Atlas nightly map refresh
After=network-online.target
Wants=network-online.target
# A failed night (a map that failed, or a refusal before any map ran) runs
# the alert unit with this unit's name. A theme that fails does not fail the
# night: it is carried or dropped and listed in the summary.
OnFailure=epigraph-atlas-nightly-alert@%n.service

[Service]
Type=oneshot
User=epigraph-atlas
Group=epigraph-atlas
EnvironmentFile=/etc/epigraph/atlas-nightly.env
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/atlas_nightly --apply --max-calls 400 --keep-runs 3
# 75: another copy (an operator's manual run) holds the nightly lock and
# this one did nothing. Not a failure: no alert.
SuccessExitStatus=75
# The window: a night that has not finished in three hours is killed and
# counted failed (the alert fires); the snapshot it held is released.
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
MemoryMax=1500M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
