{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"lib": ["ES2022", "DOM"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
