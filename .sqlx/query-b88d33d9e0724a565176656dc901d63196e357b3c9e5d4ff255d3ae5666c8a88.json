  "query": "\n            SELECT id, content, truth_value, agent_id, trace_id, created_at, updated_at\n            FROM claims\n            WHERE truth_value >= $1\n              AND ($2::bool OR visibility = 'public' OR owner_group_id = ANY($3::uuid[]))\n            ORDER BY truth_value DESC, created_at DESC\n            ",
