# EpiGraph Explorer as a systemd service, next to epigraph-api.service.
#
# epigraph-api runs on the host under systemd (not in Docker), so the simplest
# deployment is the same: the explorer reaches the API on loopback
# (EPIGRAPH_API_URL=http://127.0.0.1:8080, the default) and Caddy reaches the
# explorer on 127.0.0.1:8096 (Caddyfile.snippet).
#
# Install (see README.md "Deploy"):
#   sudo install -m 0755 <target-dir>/release/epigraph-explorer /usr/local/bin/epigraph-explorer
#   sudo install -m 0644 epigraph-explorer.service.example /etc/systemd/system/epigraph-explorer.service
#   sudo install -d -m 0755 /etc/epigraph
#   sudo install -m 0600 /dev/null /etc/epigraph/explorer.env   # then fill it in
#   sudo systemctl daemon-reload && sudo systemctl enable --now epigraph-explorer
#
# The binary is `epigraph-explorer`, never `server`: the deploy host shares one
# cargo target dir and the API's binary is already `release/server`.

[Unit]
Description=EpiGraph Explorer (server-rendered web UI + BFF)
# Order after the API so a boot starts it second, but do not Require= it: an
# API restart must not take the explorer down. While the API is unreachable
# the explorer serves degraded sections and 502 pages, then recovers by itself.
After=network.target epigraph-api.service

[Service]
Type=simple
# Environment only; see README.md for every variable. systemd reads this file
# as root before dropping privileges, so 0600 root:root is fine. It holds no
# client secret (the explorer is a public PKCE client), but keep it private.
# Values in the file override the Environment= default below (e.g. RUST_LOG).
EnvironmentFile=/etc/epigraph/explorer.env
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/epigraph-explorer

# SIGTERM drains in-flight requests and exits 0.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
# Exit code 2 is a configuration error (bad or missing env): restarting cannot
# fix it, so stop and let `journalctl -u epigraph-explorer` show the message.
RestartPreventExitStatus=2

# Sandboxing. The process only binds a loopback port, makes outbound HTTP to
# the API, and keeps every session in memory; it writes nothing to disk.
# Every restart therefore signs every user out.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
